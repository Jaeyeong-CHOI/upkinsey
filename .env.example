# Never commit real secrets.
UPSTAGE_API_KEY=
# Solar Pro 3 is Upstage's current 102B MoE chat model.
UPSTAGE_MODEL=solar-pro3
UPSTAGE_BASE_URL=https://api.upstage.ai/v1/solar/chat/completions

# Local defaults. Containers/public hosting must bind 0.0.0.0.
# Cloud platforms usually provide PORT.
UPKINSEY_HOST=127.0.0.1
UPKINSEY_PORT=5173
# Optional explicit paths (CLI --static-dir / --data-dir override these).
# Build the frontend first with npm ci && npm run build.
# UPKINSEY_STATIC_DIR=/absolute/path/to/frontend-dist
# UPKINSEY_DATA_DIR=/absolute/path/to/persistent-data
# Optional fixed Nemotron dataset revision; use an available commit SHA.
# UPKINSEY_PERSONA_REVISION=
# Public deployments should require Basic Auth because simulation endpoints spend
# server-side Upstage quota. If auth is enabled but credentials are missing, the
# API refuses requests instead of silently opening paid endpoints.
UPKINSEY_REQUIRE_BASIC_AUTH=1
UPKINSEY_BASIC_AUTH_USER=operator
# Set a unique strong password before starting the authenticated app.
UPKINSEY_BASIC_AUTH_PASSWORD=
UPKINSEY_ALLOW_DESTRUCTIVE_API=0
# Keep bursts gentle by default; Upstage rate limits vary by account/plan.
UPKINSEY_MAX_PARALLEL_REQUESTS=2
UPKINSEY_MAX_ACTIVE_JOBS=2
UPKINSEY_RATE_LIMIT_PER_MINUTE=30
UPKINSEY_MAX_BODY_BYTES=1000000
UPKINSEY_MAX_DOCUMENT_BYTES=8000000
UPKINSEY_JOB_TTL_SECONDS=3600

# Retry 429/5xx/transport failures and honor Retry-After when provided.
UPSTAGE_MAX_RETRIES=8
UPSTAGE_RETRY_BACKOFF_SECONDS=1.5
UPSTAGE_MAX_RETRY_DELAY_SECONDS=60
UPSTAGE_MIN_REQUEST_INTERVAL_SECONDS=1.1

# Optional Document Parse settings for PDF → product brief extraction.
UPSTAGE_DOCUMENT_PARSE_URL=https://api.upstage.ai/v1/document-ai/document-parse
UPSTAGE_DOCUMENT_PARSE_MODEL=document-parse
UPSTAGE_DOCUMENT_PARSE_OUTPUT_FORMATS=text,html
UPSTAGE_DOCUMENT_PARSE_FILE_FIELD=document
UPSTAGE_DOCUMENT_PARSE_TIMEOUT=120
